datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String       @id @default(auto()) @map("_id") @db.ObjectId
  name                    String
  email                   String       @unique
  password                String?
  phoneNumber             String?
  username                String?
  isOwner                 Boolean      @default(false)
  profilePicture          String?
  otp                     String?
  otpExpiry               DateTime?
  isGoogleAuth            Boolean      @default(false)
  permissions             String[]
  isVerified              Boolean?     @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  googleId                String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  posts                   Post[]       @relation()
  streaks                 Streak[]
  isDeleted               Boolean      @default(false)
  deletedAt               DateTime?
  tasks         Task[]
  comments                Comment[]    @relation("UserComments")
  replies                 Reply[]      @relation("UserReplies")
  sentChats     Chat[] @relation("SentChats")
  receivedChats Chat[] @relation("ReceivedChats")
   sentMessages   Message[]  @relation("UserSentMessages")
}

model Chat {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sender      User     @relation("SentChats", fields: [senderId], references: [id])
  senderId    String   @db.ObjectId
  receiver    User     @relation("ReceivedChats", fields: [receiverId], references: [id])
  receiverId  String   @db.ObjectId
  messages    Message[]
  lastMessage String?
  updatedAt   DateTime @updatedAt
  
  @@unique([senderId, receiverId])
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    String   @db.ObjectId
  sender    User     @relation("UserSentMessages", fields: [senderId], references: [id]) // Add relation name
  senderId  String   @db.ObjectId
  read      Boolean  @default(false)
}

model Task {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}



model Post {
  imageUrl   String?
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  content    String
  visibility String    @default("PUBLIC")
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @db.ObjectId
  likes      String[]  @db.ObjectId
  comments   Comment[] @relation("PostComments")
}

model Streak {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  startDate     DateTime
  currentStreak Int?
  lastCheckIn   DateTime?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String    @db.ObjectId
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserComments", fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  post      Post     @relation("PostComments", fields: [postId], references: [id], onDelete: Cascade)
  postId    String   @db.ObjectId
  replies   Reply[]  @relation("CommentReplies")
}

model Reply {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation("UserReplies", fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  comment   Comment  @relation("CommentReplies", fields: [commentId], references: [id], onDelete: Cascade)
  commentId String   @db.ObjectId
}

model Visitor {
  id           String     @id @default(uuid()) @map("_id")
  ip           String     @unique
  visitDate    DateTime   @default(now())
  lastActivity DateTime   @default(now())
  duration     Int
  deviceType   String?
  pageViews    PageView[]
}

model PageView {
  id        String   @id @default(uuid()) @map("_id")
  visitor   Visitor  @relation(fields: [visitorId], references: [id])
  visitorId String
  path      String
  timestamp DateTime @default(now())
}